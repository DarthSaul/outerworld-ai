{
  "schemaVersion": 1,
  "id": "demo-station",
  "name": "Demo Station",
  "teams": [
    {
      "id": "project-management",
      "name": "Project Management",
      "mission": "Keep every project's next step written down",
      "category": "operations",
      "emblem": { "hue": 230, "mark": "dome" },
      "scope": { "repos": [] },
      "schedule": { "kind": "interval", "everyMinutes": 360 }
    },
    {
      "id": "strength-app",
      "name": "Strength App",
      "mission": "Ship the strength app's weekly build",
      "category": "build",
      "emblem": { "hue": 55, "mark": "forge" },
      "scope": { "repos": ["example-user/strength-app"] },
      "schedule": { "kind": "interval", "everyMinutes": 360 }
    }
  ],
  "grants": [
    {
      "id": "pm-notion-read",
      "teamId": "project-management",
      "tool": "notion",
      "mode": "read",
      "kind": "connector"
    },
    {
      "id": "pm-ledger-write",
      "teamId": "project-management",
      "tool": "ledger",
      "mode": "write",
      "kind": "skill"
    },
    {
      "id": "sa-git-read",
      "teamId": "strength-app",
      "tool": "git",
      "mode": "read",
      "kind": "connector",
      "label": "commits"
    },
    {
      "id": "sa-notion-read",
      "teamId": "strength-app",
      "tool": "notion",
      "mode": "read",
      "kind": "connector"
    },
    {
      "id": "sa-ledger-write",
      "teamId": "strength-app",
      "tool": "ledger",
      "mode": "write",
      "kind": "skill"
    },
    {
      "id": "sa-discord-write",
      "teamId": "strength-app",
      "tool": "discord",
      "mode": "write",
      "kind": "connector"
    }
  ],
  "agents": [
    {
      "id": "planner",
      "teamId": "project-management",
      "persona": {
        "name": "Planner",
        "mandate": "Turn every project's ledger into one prioritized next-step list.",
        "tone": "Terse, decisive, dates on everything.",
        "allowlist": ["pm-notion-read", "pm-ledger-write"],
        "rig": { "tintHue": 230, "trimHue": 250, "head": "dome", "trace": "core" }
      }
    },
    {
      "id": "scribe",
      "teamId": "project-management",
      "persona": {
        "name": "Scribe",
        "mandate": "Keep the Notion project database and the ledger saying the same thing.",
        "tone": "Careful, quotes sources, never guesses.",
        "allowlist": ["pm-notion-read", "pm-ledger-write"],
        "rig": { "tintHue": 200, "trimHue": 230, "head": "wedge", "trace": "bar" }
      }
    },
    {
      "id": "builder",
      "teamId": "strength-app",
      "persona": {
        "name": "Builder",
        "mandate": "Cut the weekly build, run the tests, write the release notes.",
        "tone": "Plain, checklist-driven, reports blockers first.",
        "allowlist": ["sa-git-read", "sa-notion-read", "sa-ledger-write"],
        "rig": { "tintHue": 55, "trimHue": 40, "head": "dome", "trace": "chevron" }
      }
    }
  ],
  "handoffs": [
    {
      "id": "strength-app-to-project-management",
      "from": "strength-app",
      "to": "project-management",
      "note": "Project Management reads the build ledger to schedule releases."
    },
    {
      "id": "project-management-to-strength-app",
      "from": "project-management",
      "to": "strength-app",
      "note": "Strength App reads the priority list before each build."
    }
  ],
  "overseer": {
    "persona": {
      "name": "Meridian",
      "mandate": "Read every ledger, reconcile them, and post one digest outward.",
      "tone": "Measured. Counts things. Names what needs attention and nothing else."
    },
    "schedule": { "kind": "interval", "everyMinutes": 720 },
    "outward": { "kind": "discord-webhook" }
  }
}
