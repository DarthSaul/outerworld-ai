{
  "name": "@darthsaul/outerworld-ai-generator",
  "version": "0.0.0",
  "private": true,
  "description": "Turns a Station document into ledger-repo files. Pure functions plus a small CLI.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "outerworld": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@darthsaul/outerworld-ai-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.2",
    "vitest": "^5.0.2"
  }
}
