{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://outerworld.ai/schema/v1/station-config.schema.json",
  "title": "StationConfig",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "rooms": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "props": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "web",
                    "files",
                    "memory"
                  ]
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": {}
            }
          }
        },
        "required": [
          "id",
          "name",
          "props"
        ],
        "additionalProperties": {}
      }
    },
    "lanes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "from": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "from",
          "to"
        ],
        "additionalProperties": {}
      }
    },
    "connectors": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "transport": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "http"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": [
                  "type",
                  "url"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "stdio"
                  },
                  "command": {
                    "type": "string",
                    "minLength": 1
                  },
                  "args": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "type",
                  "command",
                  "args"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "transport"
        ],
        "additionalProperties": {}
      }
    },
    "budgets": {
      "default": {},
      "type": "object",
      "properties": {
        "perRunUsd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "perAgentDailyUsd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "stationDailyUsd": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": {}
    },
    "dispatch": {
      "default": {
        "maxDepth": 1,
        "autoReview": true
      },
      "type": "object",
      "properties": {
        "maxDepth": {
          "default": 1,
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "autoReview": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "maxDepth",
        "autoReview"
      ],
      "additionalProperties": {}
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "rooms",
    "lanes",
    "connectors",
    "budgets",
    "dispatch"
  ],
  "additionalProperties": {}
}
