{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://outerworld.ai/schema/v1/station-state.schema.json",
  "title": "StationState",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "provenance": {
      "type": "object",
      "properties": {
        "asOf": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "sourceRef": {
          "type": "string"
        },
        "sourcePath": {
          "type": "string"
        }
      },
      "required": ["asOf", "sourcePath"],
      "additionalProperties": {}
    },
    "teams": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "health": {
            "type": "string",
            "enum": ["ok", "attention", "stalled"]
          },
          "healthReason": {
            "type": "string"
          },
          "run": {
            "type": "string",
            "enum": ["idle", "working", "done", "failed"]
          },
          "lastRun": {
            "type": "object",
            "properties": {
              "startedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "endedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "outcome": {
                "type": "string",
                "enum": ["done", "failed"]
              },
              "sessionUrl": {
                "type": "string",
                "format": "uri"
              },
              "grantsUsed": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "grantId": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]*$"
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": ["grantId", "count"],
                  "additionalProperties": {}
                }
              },
              "ledger": {
                "type": "object",
                "properties": {
                  "changed": {
                    "type": "boolean"
                  },
                  "linesAdded": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "linesRemoved": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "summary": {
                    "type": "string"
                  }
                },
                "required": ["changed", "linesAdded", "linesRemoved"],
                "additionalProperties": {}
              },
              "error": {
                "type": "string"
              }
            },
            "required": ["startedAt", "grantsUsed", "ledger"],
            "additionalProperties": {}
          },
          "recentRuns": {
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "startedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                },
                "endedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                },
                "outcome": {
                  "type": "string",
                  "enum": ["done", "failed"]
                },
                "sessionUrl": {
                  "type": "string",
                  "format": "uri"
                },
                "grantsUsed": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "grantId": {
                        "type": "string",
                        "pattern": "^[a-z0-9][a-z0-9-]*$"
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": ["grantId", "count"],
                    "additionalProperties": {}
                  }
                },
                "ledger": {
                  "type": "object",
                  "properties": {
                    "changed": {
                      "type": "boolean"
                    },
                    "linesAdded": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "linesRemoved": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "summary": {
                      "type": "string"
                    }
                  },
                  "required": ["changed", "linesAdded", "linesRemoved"],
                  "additionalProperties": {}
                },
                "error": {
                  "type": "string"
                }
              },
              "required": ["startedAt", "grantsUsed", "ledger"],
              "additionalProperties": {}
            }
          },
          "ledger": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "exists": {
                "type": "boolean"
              },
              "sections": {
                "type": "object",
                "properties": {
                  "nextSteps": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "waitingOn": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "log": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": ["nextSteps", "waitingOn", "log"],
                "additionalProperties": {}
              },
              "changedInLastRun": {
                "type": "boolean"
              }
            },
            "required": ["path", "exists", "changedInLastRun"],
            "additionalProperties": {}
          },
          "degraded": {
            "type": "boolean"
          }
        },
        "required": ["health", "run", "recentRuns", "ledger", "degraded"],
        "additionalProperties": {}
      }
    },
    "agents": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": ["idle", "working", "done", "failed"]
          },
          "note": {
            "type": "string"
          }
        },
        "required": ["state"],
        "additionalProperties": {}
      }
    },
    "handoffs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "carrying": {
            "type": "boolean"
          }
        },
        "required": ["carrying"],
        "additionalProperties": {}
      }
    },
    "overseer": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": ["idle", "reconciling", "reported", "attention"]
        },
        "lastRunStartedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "lastOutwardPostAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "reconciled": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "attention": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "teamId": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": ["teamId", "reason"],
            "additionalProperties": {}
          }
        },
        "digest": {
          "type": "string"
        }
      },
      "required": ["state", "reconciled", "attention"],
      "additionalProperties": {}
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "level": {
            "type": "string",
            "enum": ["warn", "error"]
          },
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["level", "path", "message"],
        "additionalProperties": {}
      }
    }
  },
  "required": ["schemaVersion", "provenance", "teams", "agents", "handoffs", "overseer", "issues"],
  "additionalProperties": {}
}
