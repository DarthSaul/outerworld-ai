{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://outerworld.ai/schema/v1/run-record.schema.json",
  "title": "RunRecord",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "teamId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "endedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "outcome": {
      "type": "string",
      "enum": ["done", "failed"]
    },
    "sessionId": {
      "type": "string"
    },
    "sessionUrl": {
      "type": "string",
      "format": "uri"
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "agentId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "state": {
            "type": "string",
            "enum": ["idle", "working", "done", "failed"]
          },
          "note": {
            "type": "string"
          }
        },
        "required": ["agentId", "state"],
        "additionalProperties": {}
      }
    },
    "grantsUsed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "grantId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["grantId", "count"],
        "additionalProperties": {}
      }
    },
    "ledger": {
      "type": "object",
      "properties": {
        "changed": {
          "type": "boolean"
        },
        "linesAdded": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "linesRemoved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "summary": {
          "type": "string"
        }
      },
      "required": ["changed", "linesAdded", "linesRemoved"],
      "additionalProperties": {}
    },
    "error": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": ["schemaVersion", "teamId", "startedAt", "agents", "grantsUsed", "ledger"],
  "additionalProperties": {}
}
