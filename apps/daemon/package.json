{
  "name": "daemon",
  "version": "0.0.0",
  "private": true,
  "description": "The Outerworld AI daemon: config, HTTP API, SSE, auth, and the built SPA on 127.0.0.1.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js",
    "dev": "node --watch --enable-source-maps dist/main.js"
  },
  "dependencies": {
    "@darthsaul/outerworld-ai-core": "workspace:*",
    "@darthsaul/outerworld-ai-runtime": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.11"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "vitest": "^5.0.2"
  }
}
